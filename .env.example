# =============================================================================
# CREDO Finanzportal - Umgebungsvariablen
# =============================================================================
# Kopieren als .env.production und Werte anpassen

# ── Datenbank ────────────────────────────────────────────
DB_PASSWORD=change-me-strong-password

# ── Verschlüsselung (für E-Mail-Credentials im AdminCenter) ─
ENCRYPTION_KEY=change-me-32-character-secret-key!

# ── E-Mail-Versand (SMTP) ───────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=finanzportal@credo.de
SMTP_PASS=change-me

# ── Absender ─────────────────────────────────────────────
MAIL_FROM_NAME=CREDO Finanzportal
MAIL_FROM_EMAIL=finanzportal@credo.de

# ── Admin ────────────────────────────────────────────────
ADMIN_INITIAL_PASSWORD=change-me-admin

# ── App ──────────────────────────────────────────────────
APP_URL=https://finance.fes-credo.de

# ── Loeschjob (DSGVO), siehe DEPLOYMENT.md §13 ───────────
# Ohne Eintrag gelten die Werte im Code. Ungueltiger Wert → Loeschjob startet nicht (fail-closed).
# Frist in Tagen nach Einreichung (ganze Zahl ab 1), Standard 90:
# RETENTION_FRIST_TAGE=90
# Moratorium VMA-Nachkorrektur: Reisekosten-Altbestand (vor Release 1b) bis zu diesem Tag
# (ausschliesslich) nicht loeschen, nach der Frist nur IBAN/Kontoinhaber, Belege und PDF entfernen.
# Standard 2027-03-31, Prueftermin 01.03.2027. Verlaengern nur nach Pruefung mit dem Datenschutzbeauftragten:
# RETENTION_MORATORIUM_BIS=2027-03-31
